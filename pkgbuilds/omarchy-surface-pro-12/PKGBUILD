# Experimental support for the Microsoft Surface Pro 12in 1st Edition.
pkgname=omarchy-surface-pro-12
pkgver=1
pkgrel=1
pkgdesc='Experimental fixed-DTB installed boot support for Surface Pro 12in 1st Edition'
arch=('aarch64')
url='https://github.com/omacom/omarchy-pkgs'
license=('custom')
depends=('limine-mkinitcpio-hook' 'limine-snapper-sync' 'mkinitcpio' 'snapper' 'systemd-ukify')
makedepends=('python')
options=('!strip')
_dtb=x1p42100-microsoft-sp12in.dtb
_sha256=d7ed4b073c7344cb0bb2c3f7d00655df60b473588a5c0364af54537dc2c672c7
source=("${_dtb}" 'README.package.md' 'omarchy-surface-pro-12.conf' '90-omarchy-surface-pro-12-sd-encrypt.conf' 'uki-surface-pro-12.conf' 'surface-pre-boot-cleanup' 'verify-surface-uki.py')
sha256sums=('d7ed4b073c7344cb0bb2c3f7d00655df60b473588a5c0364af54537dc2c672c7'
            '09eb03b61c0c06af32088b2065ed6acd2278eacfb6f60743b78f014c00ffd23c'
            '06b1b8b1eda85c6b7d8f87be06e37c167bb0f5c581955a2f00864ec59c6468b9'
            '67d713758dd8061f337f1a852f6b3665cac1f6eede67559842fa9f964a6cd7cf'
            '10a42c44dc4df1526e78386053a8d0b7c2b7a71cd2dcec03f20ca372ca66d144'
            'fabefbb073eef0ac14d1986ab917229fbde853832f576f81017c9efab8baba5f'
            'f3be1840e3510e4e42764da10715721ffa07f2d2c57fb120a0c11a3de28a60b3')

prepare() {
  printf '%s  %s\n' "$_sha256" "$_dtb" | sha256sum -c -
  python3 - "$_dtb" <<'PY'
import struct, sys
p = open(sys.argv[1], 'rb').read()
assert p[:4] == b'\xd0\r\xfe\xed', 'not a flattened device tree'
size = struct.unpack_from('>I', p, 4)[0]
assert size <= len(p), 'invalid FDT total size'
assert b'microsoft,surface-pro-12in\0' in p[:size], 'unexpected DT compatible'
PY
}

check() {
  prepare
  grep -Fqx 'MKINITCPIO_UKI_OPTIONS="--ukiconfig /etc/kernel/uki-surface-pro-12.conf"' omarchy-surface-pro-12.conf
  grep -Fqx 'DeviceTree=/usr/lib/omarchy-surface-pro-12/x1p42100-microsoft-sp12in.dtb' uki-surface-pro-12.conf
  grep -Fqx 'HOOKS=(${HOOKS[@]/filesystems/sd-encrypt filesystems})' 90-omarchy-surface-pro-12-sd-encrypt.conf
  grep -Fqx 'MKINITCPIO_FALLBACK=yes' omarchy-surface-pro-12.conf
  grep -Fqx 'KERNEL_CMDLINE[default]+="initramfs_async=0 clk_ignore_unused pd_ignore_unused arm64.nopauth"' omarchy-surface-pro-12.conf
  grep -Fqx 'rm -f /etc/limine-entry-tool.d/qualcomm-snapdragon.conf' surface-pre-boot-cleanup
}

package() {
  install -Dm644 "$_dtb" "$pkgdir/usr/lib/$pkgname/$_dtb"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omarchy-surface-pro-12.conf "$pkgdir/etc/limine-entry-tool.d/90-omarchy-surface-pro-12.conf"
  install -Dm644 90-omarchy-surface-pro-12-sd-encrypt.conf "$pkgdir/etc/mkinitcpio.conf.d/90-omarchy-surface-pro-12-sd-encrypt.conf"
  install -Dm644 uki-surface-pro-12.conf "$pkgdir/etc/kernel/uki-surface-pro-12.conf"
  install -Dm755 surface-pre-boot-cleanup "$pkgdir/etc/boot/hooks/pre.d/95-omarchy-surface-pro-12"
  install -Dm755 verify-surface-uki.py "$pkgdir/usr/lib/$pkgname/verify-surface-uki.py"
}
